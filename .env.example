# Copy to .env and adjust if needed. Defaults assume the VM has 10 vCPU / 28 GB RAM
# (Intel Core 5 210H host, VirtualBox 7.2.16, Ubuntu Server 26.04 LTS guest) as confirmed
# for this experiment. These are Docker resource *limits* per container, not host allocation.

# --- PostgreSQL (Scenario B: native converged — relational + pgvector + jsonb + RLS) ---
POSTGRES_USER=mldb
POSTGRES_PASSWORD=mldb_dev_only_change_me
POSTGRES_DB=mldb
POSTGRES_CPUS=3
POSTGRES_MEM=6g
POSTGRES_REPLICA_CPUS=1
POSTGRES_REPLICA_MEM=2g

# --- pgbouncer (transaction-pooling mode, needed for Scenario B6) ---
PGBOUNCER_CPUS=0.5
PGBOUNCER_MEM=256m

# --- MongoDB (Scenario A/C: NoSQL layer) ---
MONGO_INITDB_ROOT_USERNAME=mldb
MONGO_INITDB_ROOT_PASSWORD=mldb_dev_only_change_me
MONGO_CPUS=2
MONGO_MEM=4g

# --- Qdrant (Scenario A/C: vector layer) ---
QDRANT_CPUS=2
QDRANT_MEM=4g

# --- Bridge service (Scenario C: ledger-anchored cross-layer layer) ---
BRIDGE_CPUS=1
BRIDGE_MEM=1g
BRIDGE_PORT=8080

# --- Fabric (Scenario C: brought up separately via fabric/network-up.sh, not this compose file) ---
# IMPORTANT: Docker Compose's .env file does NOT expand shell variables like
# $HOME -- ${HOME}/fabric-samples here would be read as the literal string
# "${HOME}/fabric-samples", not your actual home directory, and Docker would
# try to mount a directory with that literal name. Replace the line below
# with the actual absolute path once fabric-samples is installed, e.g.:
#   FABRIC_SAMPLES=/home/youruser/fabric-samples
FABRIC_SAMPLES=/CHANGE_ME_TO_ABSOLUTE_PATH/fabric-samples
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=accessledger

# --- Embedding model (local, no external API calls -- reproducible, no network dependency) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
